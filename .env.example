# Copy this file to .env for local development
# In production (Railway), set these as environment variables in the dashboard.

# ──── Database ───────────────────────────────────────────────
DATABASE_URL=postgres://user:password@host:5432/flora

# ──── Auth ───────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-long-random-string

# ──── Server ─────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ──── Email (signup PIN + password reset) ────────────────────
# EmailJS dashboard: https://dashboard.emailjs.com
#
# 1. Email Services — connect Gmail (note the Service ID, e.g. service_k9v7rmd)
# 2. Email Templates — "One-Time Password" (or duplicate for reset)
#    Required template fields:
#      To Email:  {{email}}
#      Body code: {{passcode}}
# 3. Account → API keys — Public + Private (server needs BOTH)
# 4. Account → Security — enable "Allow API requests from non-browser applications"
#
EMAILJS_SERVICE_ID=service_k9v7rmd
EMAILJS_TEMPLATE_ID=template_xxxxxxx
# Optional — separate template for "Forgot password" emails (recommended)
EMAILJS_RESET_TEMPLATE_ID=template_yyyyyyy
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key

# Resend (alternative — needs verified domain for any recipient)
RESEND_API_KEY=
RESEND_FROM=Flora & Gifts <onboarding@resend.dev>

# SMTP (local dev only; Gmail often fails on Railway)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Flora & Gifts <no-reply@flora.local>
SMTP_SECURE=false
